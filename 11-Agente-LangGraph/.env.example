OPENAI_BASE_URL=https://<tu-recurso>.services.ai.azure.com/openai/v1
OPENAI_API_KEY=<tu-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=<nombre-del-deployment>

# Opcional: activa trazas en LangSmith para ver el recorrido del grafo.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=<tu-langsmith-api-key>
LANGSMITH_PROJECT=chispa-langgraph

# Opcional si tu cuenta esta en la region EU.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
