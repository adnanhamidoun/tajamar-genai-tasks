# --- SUPABASE CONFIGURATION ---
# Obtén estas en tu panel de Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI CONFIGURATION (AZURE OPENAI) ---
# Se utiliza para el análisis de visión de alimentos
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini # O el nombre de tu despliegue de visión

# --- APP CONFIGURATION ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
